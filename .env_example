# LLM 설정 - Ollama 사용
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
LLM_TIMEOUT_SEC=60

# 서버 설정
PORT=8001
ALLOWED_ORIGINS=http://localhost:5173

MYSQL_HOST=
MYSQL_PORT=
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=

# 로그 버퍼 튜닝. 미설정/파싱 실패/0 이하면 아래 기본값을 사용한다.
LOG_FLUSH_SIZE=50
LOG_FLUSH_INTERVAL_SEC=10
LOG_MAX_RETRIES=3
LOG_MAX_FAILED=500

# Dev/E2E 전용: true이면 MySQL 환경변수 무시하고 in-memory SQLite로 시작.
# production에는 절대 켜지 말 것 (프로세스 종료 시 모든 로그가 사라짐).
SION_USE_IN_MEMORY_DB=false

# Dev/E2E 전용: true이면 /api/test/{position,status,event} 라우트를 등록한다.
# 이 라우트는 인증이 없고, 가짜 AGV 데이터를 모든 웹 클라이언트에 브로드캐스트하며
# 실제 로그 DB에 기록하고 LLM 호출까지 유발한다. CORS는 브라우저만 막으므로
# production에는 절대 켜지 말 것 (꺼져 있으면 라우트 자체가 없어 404).
SION_ENABLE_TEST_API=false
