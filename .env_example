# LLM 설정 - Ollama 사용
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
LLM_TIMEOUT_SEC=60

# 서버 설정
PORT=8001
ALLOWED_ORIGINS=http://localhost:5173

MYSQL_HOST=
MYSQL_PORT=
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=

# Dev/E2E 전용: true이면 MySQL 환경변수 무시하고 in-memory SQLite로 시작.
# production에는 절대 켜지 말 것 (프로세스 종료 시 모든 로그가 사라짐).
SION_USE_IN_MEMORY_DB=false